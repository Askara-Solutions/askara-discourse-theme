{
  "extraKnownMarketplaces": {
    "askara-solutions": {
      "source": {
        "source": "github",
        "repo": "Askara-Solutions/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "askara-workflow@askara-solutions": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(Edit|Write|MultiEdit|Bash)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-worktree-isolation.sh\""
          }
        ]
      }
    ]
  }
}
