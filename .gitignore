.DS_Store
*.log
.vscode/

# Local credentials — never committed. Convention: one `.env.<service>` file per
# external service, sourced by shell commands, never read back into chat/logs.
.env
.env.*

# Loop runtime state (ralph-loop / askara-workflow) — local only, never committed.
.loop/

# Generated hero preview (dev tool) — rebuild with dev/hero-preview/build.py; never committed.
dev/hero-preview/*.built.html
